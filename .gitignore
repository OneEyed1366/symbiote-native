node_modules/
build/
build-ngc/
dist/
*.tsbuildinfo

# local `pnpm pack`/`npm pack` output — used for local-only dev testing (installing an
# unpublished package into a standalone examples/* app before it has a real npm release)
*.tgz

# co-located svelte-compiler output a *.smoke.test.ts writes next to the real .svelte source
# it's compiling (so the compiled file's own relative imports resolve without copying its
# sibling .ts dependencies) — always cleaned up in afterEach, this is insurance against a
# crash leaving one behind.
.smoke-compiled-*.mjs

# scripts/emit-svelte-declarations.mjs stages svelte2tsx's whole-package emit here before copying
# only the *.svelte.d.ts across to build/ — removed in a finally, this covers a crashed run.
.svelte-dts/

# Native source vendored into a package's proxy podspec at pod-install time (CocoaPods'
# Dir.glob never crosses a symlink, so a pnpm .pnpm-store symlink breaks pointing
# source_files at the nested lib in place — see symbiote-third-party-native-view skill).
packages/*/.rn-*

# Codegen spec files vendored at `prepare` time from a wrapped native module (jsSrcsDir
# must be a literal path react-native codegen can lstat directly — pnpm never nests a
# dependency inside its dependent's own node_modules, so the source has to be copied in).
packages/*/codegen-specs/

# expo-modules-link's atomic-write temp files (packages/expo-modules-link): created next to a
# real, tracked native project file (build.gradle, MainApplication.kt, Info.plist) during
# postinstall and renamed over it immediately; a killed process can leave one behind, and it must
# never get committed by an unrelated `git add -A`.
*.symbiote-expo-link.*.tmp

# iOS
ios/Pods/
ios/build/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
DerivedData/

# native proxy vendor symlinks (podspec-generated, see symbiote-third-party-native-view skill)
packages/*/.rn-*

# Metro / Hermes
.metro-health-check*
*.jsbundle

# misc
.DS_Store

# debug session artifacts (simulator/device logs, watched process pids)
*.log
*.pid

# raw simulator screen recordings — convert to an optimized gif under assets/ instead
*.mov

# hidden folders are local-only (.docs, .notes, .vendors, …); dotfiles stay tracked
.*/
# ...except tooling config that must ship to every clone/CI run, and project Claude
# skills/rules (.claude/skills, .claude/rules) — shared team knowledge, not personal scratch
!.github/
!.changeset/
!.husky/
!.claude/
.husky/_/

# ~/.gitignore_global excludes CLAUDE.md globally (personal-scratch default across all repos);
# re-include it here since this repo's CLAUDE.md is checked-in project documentation, not scratch.
!CLAUDE.md

# ~/.gitignore_global has a bare `docs`/`docs/` rule (personal-scratch leftover, matches ANY
# dir named "docs" at any depth) that would otherwise swallow the Astro Starlight content
# collection below — re-include it explicitly for this repo. Note the collection has a
# doubly-nested docs/docs/ (Starlight's collection root, then this repo's own "docs" section
# folder inside it) — both levels match the bare rule independently and both need unignoring.
!apps/docs-site/src/content/docs/
!apps/docs-site/src/content/docs/docs/
