{
  "android": {
    "gradleProjectName": "expo-tracking-transparency",
    "modules": [
      {
        "importPath": "expo.modules.trackingtransparency.TrackingTransparencyModule",
        "className": "TrackingTransparencyModule",
        "nativeName": "ExpoTrackingTransparency"
      }
    ],
    "manifestPermissions": ["com.google.android.gms.permission.AD_ID"]
  },
  "ios": {
    "infoPlistKeys": {
      "NSUserTrackingUsageDescription": "This app tracks your activity across other apps and websites."
    }
  }
}
