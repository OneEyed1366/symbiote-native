{
  "name": "@symbiote-native/devtools",
  "version": "0.1.0",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "main": "./react-native.ts",
  "files": [
    "dist",
    "react-native.ts",
    "src"
  ],
  "scripts": {
    "build": "vite build && VITE_ROZENITE_TARGET=react-native vite build --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rozenite/plugin-bridge": "catalog:",
    "@symbiote-native/engine": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.86"
  },
  "devDependencies": {
    "@rozenite/vite-plugin": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-web": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
