{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "types": ["node"],
    "jsx": "preserve",
    "jsxImportSource": "@symbiote-native/vue",
    "paths": {
      "react-native-reanimated": ["./node_modules/react-native-reanimated"],
      "react-native-reanimated/src/*": [
        "./node_modules/react-native-reanimated/lib/typescript/*"
      ],
      "react-native-worklets": ["./node_modules/react-native-worklets"],
      "vue": ["../../adapters/vue/node_modules/vue"],
      "@symbiote-native/vue": ["../../adapters/vue/src/index.ts"],
      "@symbiote-native/vue/jsx-runtime": [
        "../../adapters/vue/src/jsx-runtime.ts"
      ],
      "@symbiote-native/vue/jsx-dev-runtime": [
        "../../adapters/vue/src/jsx-runtime.ts"
      ],
      "@symbiote-native/reanimated": ["./src/core/index.ts"],
      "@symbiote-native/reanimated/vue": ["./src/vue/index.ts"]
    }
  },
  "include": [
    "../../examples/vue-tsx/screens/reanimated",
    "../../examples/vue-tsx/components/ActionButton.tsx"
  ]
}
