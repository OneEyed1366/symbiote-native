{
  "name": "@symbiote-native/calendar",
  "version": "0.1.0",
  "description": "expo-calendar wrapped for SymbioteNative — one framework-agnostic core, built once and reachable from the React, Vue, Svelte, Solid, and Angular adapters. Both surfaces: the modern ExpoCalendar/ExpoCalendarEvent/ExpoCalendarReminder/ExpoCalendarAttendee API (default entry) and the legacy function-based API (/legacy subpath).",
  "license": "MIT",
  "keywords": [
    "react-native",
    "symbiote-native",
    "expo-calendar",
    "react",
    "vue",
    "svelte",
    "solid",
    "angular",
    "calendar",
    "events",
    "reminders"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneEyed1366/symbiote-native.git",
    "directory": "packages/calendar"
  },
  "homepage": "https://github.com/OneEyed1366/symbiote-native/tree/master/packages/calendar#readme",
  "bugs": {
    "url": "https://github.com/OneEyed1366/symbiote-native/issues"
  },
  "author": "Andrey Prokopenko <psevdoproger@gmail.com>",
  "type": "module",
  "main": "src/core/index.ts",
  "module": "src/core/index.ts",
  "types": "src/core/index.ts",
  "exports": {
    ".": "./src/core/index.ts",
    "./vue": "./src/vue/index.ts",
    "./react": "./src/react/index.ts",
    "./svelte": "./src/svelte/index.ts",
    "./solid": "./src/solid/index.ts",
    "./angular": {
      "types": "./build-ngc/angular/index.d.ts",
      "react-native": "./build-ngc/angular/index.js",
      "default": "./src/angular/index.ts"
    },
    "./legacy": "./src/legacy/index.ts"
  },
  "files": [
    "src",
    "build",
    "build-ngc",
    "native-link.json",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.detox.*"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/core/index.js",
    "module": "./build/core/index.js",
    "types": "./build/core/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/core/index.d.ts",
        "default": "./build/core/index.js"
      },
      "./vue": {
        "types": "./build/vue/index.d.ts",
        "default": "./build/vue/index.js"
      },
      "./react": {
        "types": "./build/react/index.d.ts",
        "default": "./build/react/index.js"
      },
      "./svelte": {
        "types": "./build/svelte/index.d.ts",
        "default": "./build/svelte/index.js"
      },
      "./solid": {
        "types": "./build/solid/index.d.ts",
        "default": "./build/solid/index.js"
      },
      "./angular": {
        "types": "./build-ngc/angular/index.d.ts",
        "react-native": "./build-ngc/angular/index.js",
        "default": "./src/angular/index.ts"
      },
      "./legacy": {
        "types": "./build/legacy/index.d.ts",
        "default": "./build/legacy/index.js"
      }
    }
  },
  "scripts": {
    "prepare": "pnpm run ng:build",
    "typecheck": "tsc --build",
    "clean": "rm -rf build-ngc",
    "ng:build": "pnpm run clean && ngc -p tsconfig.angular.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "expo-calendar": "catalog:",
    "expo-modules-core": "catalog:"
  },
  "peerDependencies": {
    "@symbiote-native/angular": "workspace:^",
    "@symbiote-native/engine": "workspace:^",
    "@symbiote-native/react": "workspace:^",
    "@symbiote-native/solid": "workspace:^",
    "@symbiote-native/svelte": "workspace:^",
    "@symbiote-native/vue": "workspace:^",
    "@angular/core": ">=20",
    "@vue/runtime-core": "^3.5.13",
    "react": ">=19.0.0",
    "react-native": ">=0.86",
    "solid-js": ">=1.9.0",
    "svelte": ">=5.56.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@symbiote-native/angular": {
      "optional": true
    },
    "@symbiote-native/react": {
      "optional": true
    },
    "@symbiote-native/solid": {
      "optional": true
    },
    "@symbiote-native/svelte": {
      "optional": true
    },
    "@symbiote-native/vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@vue/runtime-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/compiler": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/core": "catalog:",
    "@symbiote-native/angular": "workspace:*",
    "@symbiote-native/engine": "workspace:*",
    "@symbiote-native/react": "workspace:*",
    "@symbiote-native/solid": "workspace:*",
    "@symbiote-native/svelte": "workspace:*",
    "@symbiote-native/test-utils": "workspace:*",
    "@symbiote-native/vue": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vue/runtime-core": "catalog:",
    "react": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "svelte": "catalog:"
  }
}
