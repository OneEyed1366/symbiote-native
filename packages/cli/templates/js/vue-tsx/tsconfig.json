{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": [],
    // Vue's JSX is compiled by @vue/babel-plugin-jsx, never by tsc — `preserve` leaves it alone
    // and `jsxImportSource` only tells tsc whose JSX namespace to type-check against. Both
    // override @react-native/typescript-config's React defaults, which would otherwise type
    // every element here as React's.
    "jsx": "preserve",
    "jsxImportSource": "@symbiote-native/vue",
    "plugins": [{ "name": "@symbiote-native/css-parser/typescript-plugin" }]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "e2e"]
}
