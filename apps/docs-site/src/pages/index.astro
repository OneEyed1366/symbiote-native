---
import '../styles/landing.css';
import { buildSymbioteShape } from '../lib/symbiote-shape';

// The creature's whole silhouette, contoured once at build time. Nothing about
// the symbiote's geometry is computed in the browser any more — see the header
// comment in src/lib/symbiote-shape.ts for why that mattered.
const symbiote = buildSymbioteShape();

// One inline custom-property bag per limb: the pivot it swings around plus its
// own timing, so thirteen tendrils share a single CSS keyframe rule and still
// never move in step.
const limbVars = (limb: (typeof symbiote.tendrils)[number]) =>
  [
    `--ox:${limb.ox}px`,
    `--oy:${limb.oy}px`,
    `--dur:${limb.dur}`,
    `--delay:${limb.delay}`,
    `--rot-a:${limb.rotA}`,
    `--rot-b:${limb.rotB}`,
    `--sc-a:${limb.scaleA}`,
    `--sc-b:${limb.scaleB}`,
  ].join(';');

// ~150 chars, leads with the value prop and names every shipping adapter —
// meta descriptions truncate around 160, and this feeds og:/twitter: too.
const description =
  "SymbioteNative lets React, Vue, or Angular drive real native iOS and Android views through stock React Native's Fabric renderer — one core, N adapters.";

// Single source of truth for the title so <title>, og:title and twitter:title
// never drift apart.
const pageTitle = 'SymbioteNative — native apps for every framework';

// Absolute canonical URL for the home page. Self-referencing canonicals are a
// 2026 baseline (not just for duplicates), and og:url / canonical must be
// absolute HTTPS — relative URLs are ignored by crawlers and social platforms.
const site = 'https://docs.symbiote-native.dev';
const canonical = `${site}/`;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The "native core" of the page: one structure, swappable symbiote skin.
const symbiotes = [
  { id: 'react', label: 'React', live: true },
  { id: 'vue', label: 'Vue', live: true },
  { id: 'angular', label: 'Angular', live: true },
  { id: 'svelte', label: 'Svelte', live: true },
  { id: 'solid', label: 'Solid', live: false },
];
---

<html lang="en" data-symbiote="react">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/symbiote.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#08090d" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph — read by Facebook, LinkedIn, Slack, Discord, iMessage, Telegram… -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SymbioteNative" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter/X. Set explicitly (not via OG fallback) since this custom page
         bypasses Starlight. Bump to summary_large_image once an og:image exists. -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!--
      Yandex.Webmaster verification. This landing page has its OWN <head>, separate
      from Starlight's — the meta tag in astro.config.mjs only injects into Starlight
      pages (/docs/*), NOT here. Yandex verifies by fetching the root URL, so the tag
      must live on this page too. (Google verifies via the apex DNS TXT record.)
    -->
    <meta name="yandex-verification" content="2c452926a06c3852" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Restore the bonded live symbiote before paint so the skin never flashes. -->
    <script is:inline>
      try {
        var s = localStorage.getItem('symbiote');
        document.documentElement.dataset.symbiote =
          s === 'vue' || s === 'angular' || s === 'svelte' ? s : 'react';
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="nav">
      <a class="brand" href={base || '/'}>
        <span class="brand-mark" aria-hidden="true"></span>
        SymbioteNative
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href={`${base}/docs/`}>Docs</a>
        <a href="https://github.com/OneEyed1366/symbiote-native">GitHub</a>
      </nav>
    </header>

    <main class="shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div
            class="switcher"
            role="group"
            aria-label="Choose your symbiote framework"
          >
            <span class="eyebrow">Bond a symbiote</span>
            <div class="chips">
              {
                symbiotes.map((s) => (
                  <button
                    class={`chip${s.live ? '' : ' is-wip'}`}
                    type="button"
                    data-fw={s.id}
                    aria-pressed={s.id === 'react' ? 'true' : 'false'}
                    aria-disabled={!s.live}
                    disabled={!s.live}
                  >
                    <span class="dot" aria-hidden="true" />
                    {s.label}
                    {!s.live && <span class="soon">soon</span>}
                  </button>
                ))
              }
            </div>
          </div>

          <h1 id="hero-title">
            Native apps<br />
            for <span class="symbiote-name" data-fw>React</span>.
          </h1>

          <p class="lede">
            One native core. The framework you already know, bonded on top — no
            WebView, no rewrite, no React Native fork.
          </p>

          <div class="actions">
            <a class="button primary" href={`${base}/docs/quick-start/`}>Get started</a>
            <a class="button secondary" href={`${base}/docs/how-it-works/`}>See how it works</a>
          </div>
        </div>

        <div class="host" aria-hidden="true">
          <svg class="symbiote" viewBox="0 0 300 330" role="img">
            <defs>
              <!-- one gradient across the whole mass (not per-limb) so the creature reads as
                   one smooth ooze rather than a pile of separate shapes -->
              <linearGradient
                id="symGrad"
                gradientUnits="userSpaceOnUse"
                x1={symbiote.gradient.x1}
                y1={symbiote.gradient.y1}
                x2={symbiote.gradient.x2}
                y2={symbiote.gradient.y2}
              >
                <stop offset="0" stop-color="var(--accent)" />
                <stop offset="1" stop-color="var(--accent-2)" />
              </linearGradient>
              <clipPath id="screenClip">
                <rect x="112" y="92" width="76" height="170" rx="11" />
              </clipPath>
            </defs>

            <!-- SYMBIOTE LIMBS — the writhing crown, BEHIND the body so every blunt
                 root edge is covered by the mass and each limb reads as growing out
                 of it. Each one is a static outline that only ever gets a CSS
                 transform, which is why there is no animation script any more. -->
            <g class="tendrils" fill="url(#symGrad)">
              {
                symbiote.tendrils.map((limb) => (
                  <path class="limb" d={limb.d} style={limbVars(limb)} />
                ))
              }
            </g>

            <!-- SYMBIOTE BODY — the living mass coiled behind the device, contoured
                 at build time out of the same metaball field the runtime filter used
                 to resolve on every single frame. -->
            <g class="mass" fill="url(#symGrad)">
              {symbiote.mass.map((d) => <path d={d} />)}
            </g>

            <!-- NATIVE CORE — the one fixed device the symbiote rewrites.
                 Structure never changes between skins; only the screen recolours. -->
            <g class="phone">
              <rect class="phone-frame" x="104" y="66" width="92" height="222" rx="22" />
              <rect class="phone-screen-bg" x="112" y="92" width="76" height="170" rx="11" />
              <g clip-path="url(#screenClip)">
                <rect class="scr-bar" x="112" y="92" width="76" height="30" />
                <text class="scr-title" x="121" y="111">symbiote</text>
                <text class="scr-label" x="121" y="150">BONDS</text>
                <text class="scr-num" x="119" y="190">42</text>
                <rect class="scr-btn" x="121" y="206" width="58" height="22" rx="11" />
                <text class="scr-btn-label" x="150" y="221" text-anchor="middle">bond +1</text>
                <text class="scr-fw" x="121" y="250">React</text>
              </g>
              <rect class="phone-speaker" x="138" y="76" width="24" height="3.5" rx="1.75" />
              <circle class="phone-cam" cx="170" cy="78" r="2.4" />
              <rect class="phone-home" x="134" y="276" width="32" height="4" rx="2" />
            </g>

            <!-- SYMBIOTE GRIP — limbs that wrap OVER the front edges of the device.
                 Sits in front of the phone, hugging the rim. -->
            <g class="grips" fill="url(#symGrad)">
              {
                symbiote.grips.map((limb) => (
                  <path class="limb" d={limb.d} style={limbVars(limb)} />
                ))
              }
            </g>

            <!-- wet sheen + the looming head, peeking over the top of the device -->
            <ellipse class="sheen" cx="150" cy="42" rx="16" ry="9" transform="rotate(-24 150 42)" />

            <g class="face-anchor" transform="translate(70,-36) scale(0.8)">
            <g class="face">
              <!-- eyes — one face per symbiote -->
              <!-- iconic symbiote eyes: narrow at the bridge, sweeping wide up-and-out -->
              <g class="eyes eyes-angry">
                <path class="eye" d="M101,116 C84,92 60,82 44,90 C54,104 74,114 101,116 Z" />
                <path class="eye" d="M99,116 C116,92 140,82 156,90 C146,104 126,114 99,116 Z" />
              </g>
              <g class="eyes eyes-calm">
                <path class="eye" d="M101,112 C86,98 66,92 50,98 C58,108 76,114 101,112 Z" />
                <path class="eye" d="M99,112 C114,98 134,92 150,98 C142,108 124,114 99,112 Z" />
              </g>
              <g class="eyes eyes-friendly">
                <path class="eye" d="M101,110 C86,100 68,98 54,104 C62,112 78,116 101,110 Z" />
                <path class="eye" d="M99,110 C114,100 132,98 146,104 C138,112 122,116 99,110 Z" />
              </g>
              <g class="eyes eyes-slit">
                <path class="eye" d="M101,112 C84,104 64,100 48,104 C60,110 78,114 101,112 Z" />
                <path class="eye" d="M99,112 C116,104 136,100 152,104 C140,110 122,114 99,112 Z" />
              </g>

              <!-- mouths — fangs for the predators, a line for the calm ones -->
              <g class="maw maw-fanged">
                <path d="M64,130 Q100,123 136,130 Q138,152 100,164 Q62,152 64,130 Z" fill="rgba(0,0,0,0.55)" />
                <path class="fang" d="M70,129 L82,129 L76,149 Z" />
                <path class="fang" d="M84,128 L96,128 L90,151 Z" />
                <path class="fang" d="M98,128 L110,128 L104,151 Z" />
                <path class="fang" d="M112,128 L124,128 L118,149 Z" />
                <path class="fang" d="M126,130 L136,130 L131,146 Z" />
                <path class="fang" d="M80,163 L92,163 L86,145 Z" />
                <path class="fang" d="M96,164 L108,164 L102,144 Z" />
                <path class="fang" d="M110,163 L121,163 L116,146 Z" />
                <path class="saliva" d="M88,131 Q90,143 87,156" />
                <path class="saliva" d="M104,130 Q106,144 103,158" />
                <path class="saliva" d="M120,131 Q121,141 118,153" />
              </g>
              <g class="maw maw-spikes">
                <path d="M80,126 Q100,122 120,126 Q120,137 100,142 Q80,137 80,126 Z" fill="rgba(0,0,0,0.5)" />
                <path class="fang" d="M84,126 L92,126 L88,138 Z" />
                <path class="fang" d="M95,125 L103,125 L99,139 Z" />
                <path class="fang" d="M106,126 L114,126 L110,138 Z" />
                <path class="fang" d="M90,142 L98,142 L94,133 Z" />
                <path class="fang" d="M102,142 L110,142 L106,133 Z" />
                <path class="saliva" d="M93,127 Q94,135 92,141" />
                <path class="saliva" d="M107,127 Q108,135 105,141" />
              </g>
              <path class="lips mouth-smile" d="M82,128 Q100,144 118,128" />
              <path class="lips mouth-flat" d="M84,131 Q100,136 116,131" />
            </g>
            </g>
          </svg>
          <p class="host-label">native core · React Native Fabric</p>
        </div>
      </section>

      <section class="proof" aria-label="What stays true under every symbiote">
        <article>
          <span class="tag">Core</span>
          <h2>Stock native stack</h2>
          <p>
            Fabric, JSI, Yoga, Hermes, and the iOS/Android host stay ordinary
            React Native dependencies. SymbioteNative swaps the JavaScript renderer,
            never the native stack.
          </p>
        </article>
        <article>
          <span class="tag">Adapter</span>
          <h2>Thin per-framework skin</h2>
          <p>
            Each framework maps its lifecycle and renderer operations onto one
            small engine mutation API. Clone-on-write Fabric persistence lives in
            a single shared place.
          </p>
        </article>
        <article>
          <span class="tag">Output</span>
          <h2>Real native views</h2>
          <p>
            The result is the same Fabric shadow tree React Native already paints.
            No DOM, no WebView escape hatch, no fake native component layer.
          </p>
        </article>
      </section>

      <section class="traits" aria-labelledby="traits-title">
        <span class="eyebrow">Not just multi-platform</span>
        <h2 id="traits-title">Every adapter keeps the accent of its framework.</h2>
        <p class="traits-lede">
          Cross-surface content sharing, real framework sugar instead of a
          flattened callback surface, and CSS you can actually write — each
          landing framework by framework, not diluted into a shared subset.
        </p>

        <div class="trait-grid">
          <article class="trait">
            <span class="tag">Composition</span>
            <h3>Reach across the tree — or across surfaces</h3>
            <p>
              <code>createPortal</code> renders into another node in the same
              tree — a real Fiber-level portal, possible because Fabric runs
              in mutation mode here (React, Angular today). <code>createTunnel</code> goes further,
              and reaches every adapter: content painted by one independently mounted surface,
              registered from a totally different one, joined by nothing but
              a shared store.
            </p>
            <ul class="trait-fws" aria-label="Available on">
              <li data-fw="react">React</li>
              <li data-fw="vue">Vue</li>
              <li data-fw="angular">Angular</li>
              <li data-fw="svelte">Svelte</li>
            </ul>
          </article>

          <article class="trait">
            <span class="tag">Idiom</span>
            <h3>Sugar where the framework expects it</h3>
            <p>
              <code>v-model</code> and <code>v-show</code> work on native
              views in Vue. Angular gets real @<code>Output()</code> <code>EventEmitter</code>s
              and <code>[(value)]</code> two-way binding. Svelte 5's own <code>$bindable()</code> rune
              gives <code>bind:value</code> the same sugar, no adapter plumbing involved. Neither is
              a callback surface borrowed from React —
              each adapter speaks its own framework's grammar.
            </p>
            <ul class="trait-fws" aria-label="Available on">
              <li data-fw="vue">Vue</li>
              <li data-fw="angular">Angular</li>
              <li data-fw="svelte">Svelte</li>
            </ul>
          </article>

          <article class="trait">
            <span class="tag">Styling</span>
            <h3>Write CSS. Ship zero CSS engine.</h3>
            <p>
              A Vue SFC <code>&lt;style&gt;</code> block compiles to native
              style objects at build time — add <code>scoped</code> and it's
              scoped to the component, <code>:global(...)</code> still
              escapes out, the same semantics real Vue gives you in the
              browser. Svelte's own <code>&lt;style&gt;</code> block is
              scoped by default, through the same compile-time pipeline. CSS
              Modules and plain <code>.css</code> imports go further: <code>import styles from
              './Card.module.css'</code> resolves
              through the same shared class registry from React, Vue,
              Angular, or Svelte.
            </p>
            <ul class="trait-fws" aria-label="Available on">
              <li data-fw="react">React</li>
              <li data-fw="vue">Vue</li>
              <li data-fw="angular">Angular</li>
              <li data-fw="svelte">Svelte</li>
            </ul>
          </article>

          <article class="trait">
            <span class="tag">Testing</span>
            <h3>One e2e spec, four adapters</h3>
            <p>
              Headless <code>vitest</code> covers component and integration
              logic with no simulator involved. <code>Detox</code> drives the
              real app end to end — and because it attaches below the
              renderer SymbioteNative replaces, the identical spec file runs
              unmodified against the React, Vue SFC, Vue TSX, and Svelte
              canaries. Angular has its own real-device Detox suite too.
            </p>
            <ul class="trait-fws" aria-label="Available on">
              <li data-fw="react">React</li>
              <li data-fw="vue">Vue</li>
              <li data-fw="angular">Angular</li>
              <li data-fw="svelte">Svelte</li>
            </ul>
          </article>
        </div>
      </section>

      <section class="demo" aria-labelledby="demo-title">
        <div class="demo-copy">
          <span class="eyebrow">Same surface, different host</span>
          <h2 id="demo-title">Four symbiotes, one native core.</h2>
          <p>
            React is the reference canary. Vue proves the native core is no longer
            tied to React's reconciler. Angular proves it again, through a completely
            different rendering model. Svelte proves it a third time, with no
            host-renderer seam to hook at all. All four flow through the same engine
            and the same stock Fabric host.
          </p>
        </div>
        <!--
          These were three 4.5 MB animated GIFs, all decoding at once. A GIF has no
          hardware decode path and no way to pause, so the browser holds every frame
          of all three in memory forever — survivable on a desktop, fatal on a phone.
          They are H.264 now (~0.6 MB each, hardware-decoded), and `data-src` keeps
          even that off the wire until the section scrolls into view, at which point
          only the bonded framework's clip loads.
        -->
        <div class="demo-grid">
          {
            [
              { id: 'react', label: 'React', file: 'react-demo' },
              { id: 'vue', label: 'Vue', file: 'vue-demo' },
              { id: 'angular', label: 'Angular', file: 'angular-demo' },
              { id: 'svelte', label: 'Svelte', file: 'svelte-demo' },
            ].map((demo) => (
              <figure data-fw={demo.id} class={demo.id === 'react' ? 'is-active' : undefined}>
                <video
                  poster={`${base}/${demo.file}.webp`}
                  width="260"
                  height="564"
                  preload="none"
                  muted
                  loop
                  playsinline
                  disablepictureinpicture
                  aria-label={`${demo.label} driving a native SymbioteNative counter demo`}
                >
                  {/* H.264 first so Safari lands on the hardware decoder; WebM
                      catches the Chromium and Firefox builds that ship without
                      proprietary codecs, which would otherwise sit on the poster. */}
                  <source data-src={`${base}/${demo.file}.mp4`} type="video/mp4" />
                  <source data-src={`${base}/${demo.file}.webm`} type="video/webm" />
                </video>
                <figcaption>
                  <span class="dot" data-fw={demo.id} />
                  {demo.label} · live adapter
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section class="seam" aria-labelledby="seam-title">
        <span class="eyebrow">The seam</span>
        <h2 id="seam-title">Framework → adapter → engine → Fabric.</h2>
        <ol class="pipeline" aria-label="SymbioteNative render pipeline">
          <li>React · Vue · Angular · Svelte</li>
          <li>thin reconciler</li>
          <li>@symbiote-native/engine</li>
          <li>nativeFabricUIManager</li>
          <li>stock React Native</li>
        </ol>
      </section>

      <section class="status" aria-labelledby="status-title">
        <span class="eyebrow">Where things stand</span>
        <h2 id="status-title">Small surface, real pipe.</h2>
        <ul>
          <li data-fw="react" class="is-active">
            <span class="dot" aria-hidden="true"></span>
            <strong>React</strong>
            <span class="state">reference adapter — iOS + Android canary</span>
          </li>
          <li data-fw="vue">
            <span class="dot" aria-hidden="true"></span>
            <strong>Vue 3</strong>
            <span class="state">full canary parity on the shared engine</span>
          </li>
          <li data-fw="angular">
            <span class="dot" aria-hidden="true"></span>
            <strong>Angular</strong>
            <span class="state">second non-React proof — full component parity</span>
          </li>
          <li data-fw="svelte">
            <span class="dot" aria-hidden="true"></span>
            <strong>Svelte</strong>
            <span class="state">DOM-shim adapter — full component parity</span>
          </li>
          <li data-fw="solid">
            <span class="dot" aria-hidden="true"></span>
            <strong>Solid</strong>
            <span class="state">future adapter over the same seam</span>
          </li>
        </ul>
        <a class="text-link" href={`${base}/docs/project/roadmap/`}>Read the roadmap →</a>
      </section>
    </main>

    <footer class="foot">
      <span>SymbioteNative — framework-agnostic React Native renderer.</span>
      <a href={`${base}/docs/`}>Documentation</a>
    </footer>

    <script is:inline>
      const LIVE_SYMBIOTES = ['react', 'vue', 'angular', 'svelte'];
      const LABEL = {
        react: 'React',
        vue: 'Vue',
        svelte: 'Svelte',
        solid: 'Solid',
        angular: 'Angular',
      };

      // Same 2 (3 for Angular) accent stops as tokens.css's --gradient per skin — the favicon
      // is a plain static file on disk, so it can't read CSS vars; it's rebuilt as a data URI
      // instead. Shape mirrors the nav's own .brand-mark blob (public/symbiote.svg and
      // src/assets/symbiote-logo.svg ship the same design as the static default).
      const FAVICON_GRADIENT = {
        react: ['#61dafb', '#2bb0d6'],
        vue: ['#42d392', '#35a479'],
        angular: ['#e40035', '#f6007b', '#9c0aab'],
        svelte: ['#ff3e00', '#d63200'],
        solid: ['#4a8bc2', '#2c4f7c'],
      };

      function faviconHref(id) {
        const stops = FAVICON_GRADIENT[id] || FAVICON_GRADIENT.react;
        const stopTags = stops
          .map((color, i) => `<stop offset="${i / (stops.length - 1)}" stop-color="${color}"/>`)
          .join('');
        const svg =
          '<svg width="128" height="128" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">' +
          '<rect width="128" height="128" rx="30" fill="#030406"/>' +
          '<circle cx="64" cy="64" r="46" fill="' + stops[0] + '" opacity="0.35" filter="url(#glow)"/>' +
          '<path d="M45,20 L68,20 A40 40 0 0 1 108,60 L108,77 A31 31 0 0 1 77,108 L60,108 A40 40 0 0 1 20,68 L20,45 A25 25 0 0 1 45,20 Z" fill="url(#g)"/>' +
          '<ellipse cx="48" cy="42" rx="14" ry="9" fill="#ffffff" opacity="0.28" filter="url(#sheen)"/>' +
          '<defs><linearGradient id="g" x1="20" y1="20" x2="108" y2="108" gradientUnits="userSpaceOnUse">' +
          stopTags +
          '</linearGradient>' +
          '<filter id="glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="10"/></filter>' +
          '<filter id="sheen" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="6"/></filter>' +
          '</defs></svg>';
        return 'data:image/svg+xml,' + encodeURIComponent(svg);
      }

      const root = document.documentElement;
      const nameEl = document.querySelector('.symbiote-name');
      const screenFw = document.querySelector('.scr-fw');
      const screenNum = document.querySelector('.scr-num');
      const chips = Array.from(document.querySelectorAll('.chip'));
      const statusRows = Array.from(document.querySelectorAll('.status li'));
      const figures = Array.from(document.querySelectorAll('.demo-grid figure'));
      const faviconLink = document.querySelector('link[rel="icon"]');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');

      // Flipped by the observer below once the demo section is actually visible.
      // Until then no clip is fetched at all, whichever symbiote is bonded.
      let demoVisible = false;

      // Exactly one clip decodes at a time: the bonded one. The rest stay paused
      // on their poster frame, so switching symbiote costs one small download and
      // never leaves a second decoder running in the background.
      function syncDemos(id) {
        figures.forEach((figure) => {
          const video = figure.querySelector('video');
          if (!video) return;

          if (figure.dataset.fw !== id) {
            video.pause();
            return;
          }
          if (!demoVisible) return;

          // `data-src` on each <source> is what keeps the clip off the wire; the
          // browser only starts picking a source once they carry a real src.
          const sources = video.querySelectorAll('source[data-src]');
          if (sources.length) {
            sources.forEach((s) => {
              s.src = s.dataset.src;
              s.removeAttribute('data-src');
            });
            video.load();
          }
          // Autoplay is allowed for muted+playsinline, but a rejected promise
          // (low power mode, data saver) must not surface as an unhandled error.
          const played = video.play();
          if (played) played.catch(() => {});
        });
      }

      function apply(id) {
        if (!LIVE_SYMBIOTES.includes(id)) id = 'react';
        root.dataset.symbiote = id;
        if (nameEl) nameEl.textContent = LABEL[id];
        if (screenFw) screenFw.textContent = LABEL[id];
        if (faviconLink) faviconLink.href = faviconHref(id);
        chips.forEach((c) =>
          c.setAttribute('aria-pressed', String(c.dataset.fw === id)),
        );
        statusRows.forEach((r) => r.classList.toggle('is-active', r.dataset.fw === id));
        figures.forEach((f) => f.classList.toggle('is-active', f.dataset.fw === id));
        syncDemos(id);
      }

      const demoSection = document.querySelector('.demo-grid');
      if (demoSection && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          ([entry]) => {
            demoVisible = entry.isIntersecting;
            syncDemos(root.dataset.symbiote);
          },
          { rootMargin: '200px' },
        ).observe(demoSection);
      } else {
        demoVisible = true;
      }

      // the on-device app looks alive — bonds tick up like a running native counter
      if (screenNum && !reduce.matches) {
        let bonds = 42;
        setInterval(() => {
          screenNum.textContent = String((bonds += 1));
        }, 1500);
      }

      // The ripple's fixed 100px base size is what makes it cheap: animating
      // width/height would re-run layout and paint on every frame of the wave,
      // which is exactly the kind of tap-time jank a phone can't absorb. Scale
      // and opacity both run on the compositor instead.
      const WAVE_BASE = 100;

      function wave(x, y, color) {
        if (reduce.matches) return;
        const w = document.createElement('div');
        w.className = 'bond-wave';
        w.style.background = color;
        w.style.left = x + 'px';
        w.style.top = y + 'px';
        document.body.appendChild(w);
        const max = Math.hypot(
          Math.max(x, innerWidth - x),
          Math.max(y, innerHeight - y),
        );
        const anim = w.animate(
          [
            { transform: 'translate(-50%, -50%) scale(0)', opacity: 0.45 },
            {
              transform: 'translate(-50%, -50%) scale(' + (max * 2) / WAVE_BASE + ')',
              opacity: 0,
            },
          ],
          { duration: 640, easing: 'cubic-bezier(.22,.61,.36,1)' },
        );
        anim.onfinish = () => w.remove();
      }

      function bond(id, target) {
        if (!LIVE_SYMBIOTES.includes(id)) return;
        const chip = chips.find((c) => c.dataset.fw === id);
        const rect = (target || chip)?.getBoundingClientRect();
        const cx = rect ? rect.left + rect.width / 2 : innerWidth / 2;
        const cy = rect ? rect.top + rect.height / 2 : innerHeight / 2;
        const color =
          (chip && getComputedStyle(chip).getPropertyValue('--fw').trim()) ||
          '#61dafb';
        wave(cx, cy, color);
        apply(id);
        try {
          localStorage.setItem('symbiote', id);
        } catch (e) {}
      }

      chips.forEach((c) =>
        c.addEventListener('click', (e) => bond(c.dataset.fw, e.currentTarget)),
      );

      // The head script set the attribute pre-paint; sync text + state to it.
      apply(root.dataset.symbiote || 'react');
    </script>

  </body>
</html>
