{
  "extends": "@symbiote-native/angular/tsconfig.angular.base.json",
  "compilerOptions": {
    // Sibling packages hand ngc a prebuilt `.d.ts` (conditional `exports` entry), never raw
    // source — declaration files are exempt from TS's rootDir check, so rootDir stays scoped
    // to this directory like every other `examples/*` app.
    "rootDir": ".",
    "outDir": "build/angular",
    "baseUrl": "."
  },
  "files": ["src/App.ts", "src/css.d.ts"],
  "exclude": ["build", "e2e", "**/node_modules", "**/Pods"],
  // `ngc --watch` chokidar-watches `angularCompilerOptions.basePath` recursively; left at its
  // default (this file's directory) it also recurses into sibling ios/ and android/ and hits
  // EMFILE, so basePath narrows it to src/ — affects only the watch root, not rootDir/`files`.
  "angularCompilerOptions": {
    "basePath": "src"
  },
  // For editor tsserver only — resolved relative to THIS file, so it can't live in the shared
  // base (microsoft/TypeScript#55656). `ngc --watch` ignores it entirely; its own chokidar watch
  // is scoped by angularCompilerOptions.basePath above instead.
  "watchOptions": {
    "excludeDirectories": [
      "**/node_modules",
      "../../node_modules",
      "**/.git",
      "**/build"
    ]
  }
}
