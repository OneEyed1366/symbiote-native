{
  "name": "expo-svelte-canary",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --mode Release",
    "ios": "react-native run-ios",
    "ios:release": "react-native run-ios --mode Release",
    "lint": "eslint .",
    "pretypecheck": "css-dts .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "react-native start --reset-cache",
    "start": "react-native start",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "postinstall": "symbiote-expo-link"
  },
  "dependencies": {
    "@symbiote-native/android": "^0.1.2",
    "@symbiote-native/application": "file:../../packages/application/symbiote-native-application-0.1.0.tgz",
    "@symbiote-native/battery": "file:../../packages/battery/symbiote-native-battery-0.1.0.tgz",
    "@symbiote-native/brightness": "file:../../packages/brightness/symbiote-native-brightness-0.1.0.tgz",
    "@symbiote-native/cellular": "file:../../packages/cellular/symbiote-native-cellular-0.1.0.tgz",
    "@symbiote-native/clipboard": "file:../../packages/clipboard/symbiote-native-clipboard-0.1.0.tgz",
    "@symbiote-native/components": "file:../../core/components/symbiote-native-components-0.3.0.tgz",
    "@symbiote-native/crypto": "file:../../packages/crypto/symbiote-native-crypto-0.1.0.tgz",
    "@symbiote-native/device": "file:../../packages/device/symbiote-native-device-0.1.0.tgz",
    "@symbiote-native/engine": "file:../../core/engine/symbiote-native-engine-0.1.7.tgz",
    "@symbiote-native/expo-modules-link": "^0.2.0",
    "@symbiote-native/haptics": "file:../../packages/haptics/symbiote-native-haptics-0.1.0.tgz",
    "@symbiote-native/keep-awake": "file:../../packages/keep-awake/symbiote-native-keep-awake-0.1.0.tgz",
    "@symbiote-native/local-auth": "file:../../packages/local-auth/symbiote-native-local-auth-0.2.0.tgz",
    "@symbiote-native/localization": "file:../../packages/localization/symbiote-native-localization-0.1.0.tgz",
    "@symbiote-native/navigation": "file:../../packages/navigation/symbiote-native-navigation-2.0.3.tgz",
    "@symbiote-native/network": "file:../../packages/network/symbiote-native-network-0.1.0.tgz",
    "@symbiote-native/screen-orientation": "file:../../packages/screen-orientation/symbiote-native-screen-orientation-0.1.0.tgz",
    "@symbiote-native/secure-store": "file:../../packages/secure-store/symbiote-native-secure-store-0.1.0.tgz",
    "@symbiote-native/sensors": "file:../../packages/sensors/symbiote-native-sensors-0.2.1.tgz",
    "@symbiote-native/sharing": "file:../../packages/sharing/symbiote-native-sharing-0.1.0.tgz",
    "@symbiote-native/sms": "file:../../packages/sms/symbiote-native-sms-0.1.0.tgz",
    "@symbiote-native/splash-screen": "file:../../packages/splash-screen/symbiote-native-splash-screen-3.0.3.tgz",
    "@symbiote-native/standard-web-crypto": "file:../../packages/standard-web-crypto/symbiote-native-standard-web-crypto-0.1.0.tgz",
    "@symbiote-native/store-review": "file:../../packages/store-review/symbiote-native-store-review-0.1.0.tgz",
    "@symbiote-native/svelte": "file:../../adapters/svelte/symbiote-native-svelte-0.1.0.tgz",
    "@symbiote-native/system-ui": "file:../../packages/system-ui/symbiote-native-system-ui-0.1.0.tgz",
    "@symbiote-native/tracking-transparency": "file:../../packages/tracking-transparency/symbiote-native-tracking-transparency-0.1.0.tgz",
    "@symbiote-native/web-browser": "file:../../packages/web-browser/symbiote-native-web-browser-0.1.0.tgz",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "svelte": "^5.56.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/codegen": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@symbiote-native/css-parser": "^0.2.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "detox": "^20.51.4",
    "eslint": "^8.19.0",
    "expo-modules-autolinking": "57.0.8",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "prettier": "^3.9.1",
    "svelte-check": "^4.0.0",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "@symbiote-native/expo-modules-link": "$@symbiote-native/expo-modules-link"
  }
}
