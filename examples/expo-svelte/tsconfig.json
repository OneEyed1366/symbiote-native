{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // The adapter types the native tags, and a screen may import nothing from it
    "types": ["node", "@symbiote-native/svelte"],
    "plugins": [{ "name": "@symbiote-native/css-parser/typescript-plugin" }]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.svelte"],
  "exclude": ["**/node_modules", "**/Pods", "e2e"]
}
