{
  "name": "vue-tsx-expo-canary",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --mode Release",
    "ios": "cd ios && pod install && cd .. && react-native run-ios",
    "ios:release": "cd ios && pod install && cd .. && react-native run-ios --mode Release",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "dev": "react-native start --reset-cache",
    "start": "react-native start",
    "test": "vitest run",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "postinstall": "symbiote-expo-link"
  },
  "dependencies": {
    "@symbiote-native/android": "latest",
    "@symbiote-native/application": "latest",
    "@symbiote-native/battery": "latest",
    "@symbiote-native/brightness": "latest",
    "@symbiote-native/cellular": "latest",
    "@symbiote-native/clipboard": "latest",
    "@symbiote-native/components": "latest",
    "@symbiote-native/crypto": "latest",
    "@symbiote-native/device": "latest",
    "@symbiote-native/engine": "latest",
    "@symbiote-native/expo-modules-link": "latest",
    "@symbiote-native/haptics": "latest",
    "@symbiote-native/keep-awake": "latest",
    "@symbiote-native/local-auth": "latest",
    "@symbiote-native/localization": "latest",
    "@symbiote-native/navigation": "latest",
    "@symbiote-native/network": "latest",
    "@symbiote-native/screen-orientation": "latest",
    "@symbiote-native/secure-store": "latest",
    "@symbiote-native/sensors": "latest",
    "@symbiote-native/sharing": "latest",
    "@symbiote-native/sms": "latest",
    "@symbiote-native/splash-screen": "latest",
    "@symbiote-native/standard-web-crypto": "latest",
    "@symbiote-native/store-review": "latest",
    "@symbiote-native/system-ui": "latest",
    "@symbiote-native/tracking-transparency": "latest",
    "@symbiote-native/vue": "latest",
    "@symbiote-native/web-browser": "latest",
    "@symbiote-native/audio": "latest",
    "@symbiote-native/background-fetch": "latest",
    "@symbiote-native/background-task": "latest",
    "@symbiote-native/file-system": "latest",
    "@symbiote-native/location": "latest",
    "@symbiote-native/media-library": "latest",
    "@symbiote-native/notifications": "latest",
    "@symbiote-native/sqlite": "latest",
    "@symbiote-native/task-manager": "latest",
    "@vue/runtime-core": "^3.5.13",
    "expo": "57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/codegen": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@symbiote-native/css-parser": "latest",
    "@symbiote-native/test-utils": "latest",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@vue/babel-plugin-jsx": "^1.5.0",
    "detox": "^20.51.4",
    "eslint": "^8.19.0",
    "expo-modules-autolinking": "57.0.10",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "prettier": "^3.9.1",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.38",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        ".*"
      ]
    }
  }
}
