{
  "name": "svelte-canary",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --mode Release",
    "ios": "react-native run-ios",
    "ios:release": "react-native run-ios --mode Release",
    "lint": "eslint .",
    "pretypecheck": "css-dts .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.typecheck.json --threshold error",
    "dev": "react-native start --reset-cache",
    "start": "react-native start",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug"
  },
  "dependencies": {
    "@symbiote-native/android": "^0.1.2",
    "@symbiote-native/components": "^0.4.0",
    "@symbiote-native/engine": "^0.2.0",
    "@symbiote-native/navigation": "^2.1.0",
    "@symbiote-native/slider": "^5.1.0",
    "@symbiote-native/splash-screen": "^3.1.0",
    "@symbiote-native/svelte": "^0.2.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "svelte": "^5.56.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/codegen": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@symbiote-native/css-parser": "^0.3.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "detox": "^20.51.4",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "prettier": "^3.9.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
