{
  "name": "CanaryExpo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --mode Release",
    "ios": "react-native run-ios",
    "ios:release": "react-native run-ios --mode Release",
    "lint": "eslint .",
    "start": "react-native start",
    "dev": "react-native start --reset-cache",
    "test": "vitest run",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "postinstall": "symbiote-expo-link"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.86.0",
    "@symbiote-native/android": "^0.2.1",
    "@symbiote-native/application": "^1.0.0",
    "@symbiote-native/battery": "^1.0.0",
    "@symbiote-native/brightness": "^1.0.0",
    "@symbiote-native/cellular": "^1.0.0",
    "@symbiote-native/clipboard": "^1.0.0",
    "@symbiote-native/components": "^1.0.0",
    "@symbiote-native/crypto": "^1.0.0",
    "@symbiote-native/device": "^1.0.0",
    "@symbiote-native/engine": "^0.4.0",
    "@symbiote-native/expo-modules-link": "^0.4.1",
    "@symbiote-native/haptics": "^1.0.0",
    "@symbiote-native/keep-awake": "^1.0.0",
    "@symbiote-native/local-auth": "^1.0.0",
    "@symbiote-native/localization": "^1.0.0",
    "@symbiote-native/navigation": "^3.0.0",
    "@symbiote-native/network": "^1.0.0",
    "@symbiote-native/react": "^1.0.0",
    "@symbiote-native/screen-orientation": "^1.0.0",
    "@symbiote-native/secure-store": "^1.0.0",
    "@symbiote-native/sensors": "^1.0.0",
    "@symbiote-native/sharing": "^1.0.0",
    "@symbiote-native/sms": "^1.0.0",
    "@symbiote-native/splash-screen": "^4.0.0",
    "@symbiote-native/standard-web-crypto": "^1.0.0",
    "@symbiote-native/store-review": "^1.0.0",
    "@symbiote-native/system-ui": "^1.0.0",
    "@symbiote-native/tracking-transparency": "^1.0.0",
    "@symbiote-native/web-browser": "^1.0.0",
    "expo": "57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/codegen": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@symbiote-native/css-parser": "^0.5.0",
    "@symbiote-native/test-utils": "^0.3.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.0",
    "detox": "^20.51.4",
    "eslint": "^8.19.0",
    "expo-modules-autolinking": "57.0.10",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "prettier": "^3.9.1",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        ".*"
      ]
    }
  }
}
