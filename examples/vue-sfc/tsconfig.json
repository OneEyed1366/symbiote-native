{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // `["node"]` and not `[]`: the benchmark screens read `performance.now()`, whose only
    // declaration here comes from @types/node. Stripping it reports it undefined in an editor
    // while the real check never sees it, because tsconfig.typecheck.json restores it. Same value
    // svelte's and solid's app tsconfigs carry.
    "types": ["node"],
    "plugins": [{ "name": "@symbiote-native/css-parser/typescript-plugin" }]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue"],
  // e2e/ has its own tsconfig (Detox on Jest, `types: [jest, detox, node]`); leaving it in this
  // project too reports its jest globals as 22 undefined names.
  "exclude": ["**/node_modules", "**/Pods", "e2e"]
}
