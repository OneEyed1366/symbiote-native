{
  "name": "@symbiote-native/web",
  "version": "0.0.0",
  "description": "SymbioteNative web platform: a DOM implementation of the engine's tree host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneEyed1366/symbiote-native.git",
    "directory": "core/web"
  },
  "homepage": "https://github.com/OneEyed1366/symbiote-native/tree/master/core/web#readme",
  "bugs": {
    "url": "https://github.com/OneEyed1366/symbiote-native/issues"
  },
  "author": "Andrey Prokopenko <psevdoproger@gmail.com>",
  "keywords": [
    "react-native",
    "symbiote-native",
    "web",
    "dom",
    "renderer"
  ],
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./canary": "./src/canary.ts",
    "./interactions": "./src/interactions.ts"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "module": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./canary": {
        "types": "./build/canary.d.ts",
        "default": "./build/canary.js"
      },
      "./interactions": {
        "types": "./build/interactions.d.ts",
        "default": "./build/interactions.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@symbiote-native/engine": "workspace:*"
  },
  "devDependencies": {
    "@symbiote-native/test-utils": "workspace:*"
  }
}
