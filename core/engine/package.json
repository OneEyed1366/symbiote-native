{
  "name": "@symbiote-native/engine",
  "version": "0.4.0",
  "description": "SymbioteNative's retained shadow-tree engine \u2014 clone-on-write commit path + event normalization over React Native Fabric, shared by every framework adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneEyed1366/symbiote-native.git",
    "directory": "core/engine"
  },
  "homepage": "https://github.com/OneEyed1366/symbiote-native/tree/master/core/engine#readme",
  "bugs": {
    "url": "https://github.com/OneEyed1366/symbiote-native/issues"
  },
  "author": "Andrey Prokopenko <psevdoproger@gmail.com>",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "keywords": [
    "react-native",
    "symbiote-native",
    "fabric",
    "shadow-tree",
    "renderer-core",
    "jsi",
    "yoga",
    "cross-platform"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./mutation-buffer": "./src/mutation-buffer.ts"
  },
  "files": [
    "build",
    "cpp",
    "ios",
    "android",
    "codegen-specs",
    "symbiote-engine.podspec",
    "react-native.config.cjs"
  ],
  "codegenConfig": {
    "name": "SymbioteEngineSpec",
    "type": "modules",
    "jsSrcsDir": "codegen-specs",
    "android": {
      "javaPackageName": "dev.symbiotenative.engine"
    },
    "ios": {
      "modulesProvider": {
        "SymbioteEngine": "SymbioteEngineModule"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "module": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./mutation-buffer": {
        "types": "./build/mutation-buffer.d.ts",
        "default": "./build/mutation-buffer.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@react-native/normalize-colors": "catalog:"
  },
  "peerDependencies": {
    "react-native": ">=0.86"
  },
  "devDependencies": {
    "@symbiote-native/test-utils": "workspace:*"
  }
}
