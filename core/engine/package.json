{
  "name": "@symbiote-native/engine",
  "version": "1.7.0",
  "description": "SymbioteNative's retained shadow-tree engine — clone-on-write commit path + event normalization over React Native Fabric, shared by every framework adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneEyed1366/symbiote-native.git",
    "directory": "core/engine"
  },
  "homepage": "https://github.com/OneEyed1366/symbiote-native/tree/master/core/engine#readme",
  "bugs": {
    "url": "https://github.com/OneEyed1366/symbiote-native/issues"
  },
  "author": "Andrey Prokopenko <psevdoproger@gmail.com>",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "keywords": [
    "react-native",
    "symbiote-native",
    "fabric",
    "shadow-tree",
    "renderer-core",
    "jsi",
    "yoga",
    "cross-platform"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./mutation-buffer": "./src/mutation-buffer.ts",
    "./mutation-walk": "./src/mutation-walk.ts",
    "./retained-tree": "./src/retained-tree.ts",
    "./retained-visitor": "./src/retained-visitor.ts",
    "./inert-fabric-slot": "./src/inert-fabric-slot.ts",
    "./event-names": "./src/events/names.ts"
  },
  "files": [
    "build",
    "cpp",
    "!cpp/tests",
    "ios",
    "android",
    "codegen-specs",
    "symbiote-engine.podspec",
    "react-native.config.cjs"
  ],
  "codegenConfig": {
    "name": "SymbioteEngineSpec",
    "type": "modules",
    "jsSrcsDir": "codegen-specs",
    "android": {
      "javaPackageName": "dev.symbiotenative.engine"
    },
    "ios": {
      "modulesProvider": {
        "SymbioteEngine": "SymbioteEngineModule"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "module": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./mutation-buffer": {
        "types": "./build/mutation-buffer.d.ts",
        "default": "./build/mutation-buffer.js"
      },
      "./mutation-walk": {
        "types": "./build/mutation-walk.d.ts",
        "default": "./build/mutation-walk.js"
      },
      "./retained-tree": {
        "types": "./build/retained-tree.d.ts",
        "default": "./build/retained-tree.js"
      },
      "./retained-visitor": {
        "types": "./build/retained-visitor.d.ts",
        "default": "./build/retained-visitor.js"
      },
      "./inert-fabric-slot": {
        "types": "./build/inert-fabric-slot.d.ts",
        "default": "./build/inert-fabric-slot.js"
      },
      "./event-names": {
        "types": "./build/events/names.d.ts",
        "default": "./build/events/names.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@react-native/normalize-colors": "catalog:",
    "invariant": "catalog:"
  },
  "peerDependencies": {
    "react-native": ">=0.86"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@symbiote-native/test-utils": "workspace:*",
    "@types/invariant": "catalog:"
  }
}
