exports[`svelte <style> blocks -> scopedStyles preprocessor > examples/svelte/components/CompoundClassDemo.svelte 1`] = `
"<script lang="ts">
  // A component-local style block, and specifically the COMPOUND selector inside it —
  // \`.badge.loud\` applies only to an element carrying both tokens, and layers over \`.badge\`
  // rather than replacing it (symbiote-sfc-style-compiler skill §5b).
  //
  // What each badge proves:
  //   plain    — \`.badge\` alone; the compound rule must NOT reach it.
  //   loud     — static \`class="badge loud"\`; \`.badge\`'s radius/padding survive, \`.badge.loud\`
  //              wins the two colours it restates. \`.loud\` has no standalone rule of its own,
  //              which is the arrangement that also needed the token list, not just the key.
  //   dynamic  — the same pair through a clsx array the compiler cannot read, so it is scoped
  //              at runtime instead of at build time. Both paths must agree.
  //
  // The dynamic badge's LABEL is deliberately constant: the e2e journey proves the rule by
  // screenshot-diffing that badge across the toggle, and a label that changed with the state
  // would make the diff pass even with the compound rule dead.
  //
  // \`section-nested\` / \`section-label\` / \`row\` are NOT defined below — they come from App.css
  // and pass through unscoped, which is the other half of the rule.
  import ActionButton from './ActionButton.svelte';

  let isLoud = $state(false);
</script>

<view class="section-nested">
  <text class="section-label">Compound class · scoped style block</text>
  <view class="row">
    <view class="badge__svelte-p4np8c" testID="compound-badge-plain">
      <text class="badge-text__svelte-p4np8c">plain</text>
    </view>
    <view class="badge__svelte-p4np8c loud__svelte-p4np8c" testID="compound-badge-loud">
      <text class="badge-text__svelte-p4np8c">loud</text>
    </view>
    <view class={__symbioteScopeClass(['badge', isLoud && 'loud'], __symbioteScopedNames)} testID="compound-badge-dynamic">
      <text class="badge-text__svelte-p4np8c">dynamic</text>
    </view>
  </view>
  <text class="note-text" testID="compound-badge-readout">
    {isLoud
      ? 'dynamic badge carries both tokens — flame border, same pill shape'
      : 'dynamic badge carries only .badge — grey border'}
  </text>
  <ActionButton
    testID="compound-badge-toggle"
    title={isLoud ? 'Drop .loud' : 'Add .loud'}
    color="#ff3e00"
    onPress={() => (isLoud = !isLoud)}
  />
</view>



























<script module lang="ts">import { scopeSvelteClass as __symbioteScopeClass } from '@symbiote-native/svelte/style-scope'; import { registerRules as __symbioteRegisterRules } from '@symbiote-native/engine'; __symbioteRegisterRules([{"tokens":["badge__svelte-p4np8c"],"specificity":[0,1,0],"order":0,"style":{"padding":8,"borderRadius":999,"borderWidth":1,"borderColor":"#3a3a3a","backgroundColor":"#262626"}},{"tokens":["badge__svelte-p4np8c","loud__svelte-p4np8c"],"specificity":[0,2,0],"order":1,"style":{"borderColor":"#ff3e00","backgroundColor":"#a32d00"}},{"tokens":["badge-text__svelte-p4np8c"],"specificity":[0,1,0],"order":2,"style":{"fontSize":13,"color":"#c8c8c8"}}]); const __symbioteScopedNames = new Map([["badge","badge__svelte-p4np8c"],["badge-text","badge-text__svelte-p4np8c"],["loud","loud__svelte-p4np8c"]]);</script>
"
`;

exports[`svelte <style> blocks -> scopedStyles preprocessor > examples/svelte/screens/StyleShowcaseScreen.svelte 1`] = `
"<script lang="ts">
  // One screen over seven sheets, one panel per mechanism, kept in \`style-showcase/\`
  // The sheets are standalone files, not a \`<style>\` block, since a Svelte block is scoped per file
  import { ROUTE_NAME } from '../routes';
  import { LINE_COLOR, ROUTE_LINE_INFO } from '../navigation-lines';
  import './StyleShowcase.css';
  import './StyleShowcase.limits.css';
  import './StyleShowcase.media.css';
  import './StyleShowcase.lab.css';
  import './showcase.scss';
  import './showcase.less';
  import './showcase.styl';
  import AnimationPanel from './style-showcase/AnimationPanel.svelte';
  import CompoundPanel from './style-showcase/CompoundPanel.svelte';
  import ContainerLab from './style-showcase/ContainerLab.svelte';
  import MediaLab from './style-showcase/MediaLab.svelte';
  import VarLab from './style-showcase/VarLab.svelte';
  import DeclarationsPanel from './style-showcase/DeclarationsPanel.svelte';
  import LimitsPanel from './style-showcase/LimitsPanel.svelte';
  import MediaPanel from './style-showcase/MediaPanel.svelte';
  import MergePanel from './style-showcase/MergePanel.svelte';
  import ModulesPanel from './style-showcase/ModulesPanel.svelte';
  import PreprocessorsPanel from './style-showcase/PreprocessorsPanel.svelte';
  import SpecificityPanel from './style-showcase/SpecificityPanel.svelte';

  const lineInfo = ROUTE_LINE_INFO[ROUTE_NAME.StyleShowcase];
</script>

<safe-area-view class="screen">
  <scroll-view
    testID="style-showcase-scroll"
    class="screen"
    contentContainerStyle="scroll-content"
  >
    <view class={\`line-tag line-tag-\${lineInfo.line}\`}>
      <text class="line-tag-text">
        {\`\${lineInfo.code} · \${lineInfo.label}\`}
      </text>
    </view>

    <view class="hero-card">
      <view class="hero-badge" style={{ backgroundColor: LINE_COLOR.styling }}>
        <text class="hero-badge-text">ST</text>
      </view>
      <view class="hero-copy">
        <text class="hero-title">Styling showcase</text>
        <text class="hero-body">
          Seven stylesheets driving one screen — plain CSS, CSS Modules, SCSS,
          Less, Stylus, a sheet of things the compiler refuses and one for
          @media. Every tile is built so a dropped rule is visible rather than
          silent.
        </text>
      </view>
    </view>

    <DeclarationsPanel />
    <SpecificityPanel />
    <CompoundPanel />
    <MergePanel />
    <AnimationPanel />
    <ModulesPanel />
    <PreprocessorsPanel />
    <LimitsPanel />
    <MediaPanel />
    <MediaLab />
    <ContainerLab />
    <VarLab />
  </scroll-view>
</safe-area-view>
"
`;

