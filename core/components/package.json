{
  "name": "@symbiote-native/components",
  "version": "0.5.0",
  "description": "Framework-agnostic component logic (state machines + render functions) for SymbioteNative — written once, inherited by every adapter (React, Vue, Angular, ...).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneEyed1366/symbiote-native.git",
    "directory": "core/components"
  },
  "homepage": "https://github.com/OneEyed1366/symbiote-native/tree/master/core/components#readme",
  "bugs": {
    "url": "https://github.com/OneEyed1366/symbiote-native/issues"
  },
  "author": "Andrey Prokopenko <psevdoproger@gmail.com>",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "keywords": [
    "react-native",
    "symbiote-native",
    "cross-platform-components",
    "state-machine",
    "ui-components",
    "descriptor",
    "accessibility",
    "cross-platform"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./bootstrap": "./src/bootstrap/index.ts",
    "./host-primitives": "./host-primitives.cjs",
    "./specialize-state-style": "./specialize-state-style.cjs",
    "./lowering-fixtures": "./lowering-fixtures.cjs",
    "./state-style": "./src/state-style.ts",
    "./fold-host-bag": "./src/fold-host-bag.ts",
    "./resolve-intrinsic": "./src/resolve-intrinsic.ts"
  },
  "files": [
    "build",
    "host-primitives.cjs",
    "host-primitives.d.cts",
    "specialize-state-style.cjs",
    "specialize-state-style.d.cts",
    "lowering-fixtures.cjs",
    "lowering-fixtures.d.cts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "module": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./bootstrap": {
        "types": "./build/bootstrap/index.d.ts",
        "default": "./build/bootstrap/index.js"
      },
      "./host-primitives": {
        "types": "./host-primitives.d.cts",
        "default": "./host-primitives.cjs"
      },
      "./specialize-state-style": "./specialize-state-style.cjs",
      "./lowering-fixtures": {
        "types": "./lowering-fixtures.d.cts",
        "default": "./lowering-fixtures.cjs"
      },
      "./state-style": {
        "types": "./build/state-style.d.ts",
        "default": "./build/state-style.js"
      },
      "./fold-host-bag": {
        "types": "./build/fold-host-bag.d.ts",
        "default": "./build/fold-host-bag.js"
      },
      "./resolve-intrinsic": {
        "types": "./build/resolve-intrinsic.d.ts",
        "default": "./build/resolve-intrinsic.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "@symbiote-native/engine": "workspace:^",
    "react-native": ">=0.86"
  },
  "devDependencies": {
    "@symbiote-native/engine": "workspace:*",
    "@types/node": "catalog:"
  }
}
